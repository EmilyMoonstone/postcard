using Gtk 4.0;
using Adw 1;

template $PostcardPreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("General");

      Adw.SwitchRow notifications_row {
        title: _("New Mail Notifications");
        subtitle: _("Show a notification when new mail arrives");
      }

      Adw.SwitchRow avatars_row {
        title: _("Load Sender Avatars");
        subtitle: _("Fetch sender pictures from Gravatar, which tells them who emails you");
      }

      Adw.SwitchRow account_names_row {
        title: _("Show Account Names");
        subtitle: _("Name accounts in the sidebar by their display name instead of their address");
      }

      Adw.SwitchRow background_row {
        title: _("Run in Background");
        subtitle: _("Keep checking for mail after the window is closed");
      }

      Adw.SwitchRow autostart_row {
        title: _("Start at Login");
        subtitle: _("Start hidden when you log in and keep checking for mail");
      }

    }

    Adw.PreferencesGroup {
      title: _("Getting Mail");

      Adw.SwitchRow push_row {
        title: _("New Mail Instantly");
        subtitle: _("The server tells Postcard the moment mail arrives in an inbox. Microsoft 365 is asked every minute.");
      }

      Adw.ComboRow interval_row {
        title: _("Sync All Folders");
        subtitle: _("Also catches changes push doesn't report: other folders, and mail read or moved elsewhere");
      }
    }

    // Filled in preferences_dialog.py, one row per signature.
    Adw.PreferencesGroup signatures_group {
      title: _("Signatures");
      description: _("Pick each account's signature under Manage Accounts.");

      [header-suffix]
      Gtk.Button add_signature_button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add Signature");
        valign: center;

        styles ["flat"]
      }
    }
  }
}
