using Gtk 4.0;
using Adw 1;

template $PostcardAccountDialog: Adw.Dialog {
  title: _("Add Account");
  content-width: 520;
  content-height: 680;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel_button {
        label: _("Cancel");
      }

      [end]
      Gtk.Button add_button {
        label: _("Add");
        sensitive: false;

        styles ["suggested-action"]
      }

      [end]
      Adw.Spinner check_spinner {
        visible: false;
      }
    }

    // A failed connection test: the reason, and a way past it for a server
    // that is only unreachable from here right now.
    [top]
    Adw.Banner status_banner {
      button-label: _("Save Anyway");
    }

    content: Gtk.ScrolledWindow {
      child: Adw.PreferencesPage {
        Adw.PreferencesGroup account_group {
          title: _("Account");

          Adw.EntryRow display_name_row {
            title: _("Display Name");
          }

          Adw.EntryRow email_row {
            title: _("Email Address");
            input-purpose: email;
          }

          Adw.EntryRow username_row {
            title: _("Username");
          }

          Adw.PasswordEntryRow password_row {
            title: _("Password");
          }
        }

        Adw.PreferencesGroup provider_group {
          title: _("Server Settings");
          description: _("Filled in from your address when Postcard can find them. Pick your mail provider if it can't.");

          Adw.ComboRow hosting_row {
            title: _("Mail Provider");
            enable-search: true;
          }

          Adw.ActionRow discovery_row {
            visible: false;

            [suffix]
            Adw.Spinner discovery_spinner {
              visible: false;
            }

            styles ["property"]
          }
        }

        Adw.PreferencesGroup imap_group {
          title: _("Incoming Mail (IMAP)");

          Adw.EntryRow imap_host_row {
            title: _("Server");
          }

          Adw.EntryRow imap_port_row {
            title: _("Port");
            input-purpose: digits;
            text: "993";
          }

          Adw.ComboRow imap_security_row {
            title: _("Connection Security");

            model: Gtk.StringList {
              strings [
                "TLS",
                "STARTTLS",
              ]
            };

            selected: 0;
          }
        }

        Adw.PreferencesGroup smtp_group {
          title: _("Outgoing Mail (SMTP)");

          Adw.EntryRow smtp_host_row {
            title: _("Server");
          }

          Adw.EntryRow smtp_port_row {
            title: _("Port");
            input-purpose: digits;
            text: "587";
          }

          Adw.ComboRow smtp_security_row {
            title: _("Connection Security");

            model: Gtk.StringList {
              strings [
                "TLS",
                "STARTTLS",
              ]
            };

            selected: 1;
          }
        }

        Adw.PreferencesGroup {
          title: _("Options");

          Adw.SwitchRow remote_images_row {
            title: _("Load Remote Images");
            subtitle: _("Show images from the internet in this account's mail without asking");
          }

          Adw.ComboRow signature_row {
            title: _("Signature");
            subtitle: _("Added to new messages from this account. Manage signatures in Preferences.");
          }
        }
      };
    };
  };
}
