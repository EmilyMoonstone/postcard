using Gtk 4.0;
using Adw 1;

template $PostcardAccountsDialog: Adw.Dialog {
    title: _("Accounts");
    content-width: 480;
    content-height: 480;

    child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: Gtk.ScrolledWindow {
            child: Adw.PreferencesPage {
                Adw.PreferencesGroup accounts_group {
                    title: _("Mail Accounts");

                    [header-suffix]
                    Gtk.Box {
                        spacing: 6;

                        Gtk.Button online_accounts_button {
                            icon-name: "goa-panel-symbolic";
                            tooltip-text: _("Add from Online Accounts");

                            styles ["flat"]
                          }

                        Gtk.Button add_button {
                            icon-name: "list-add-symbolic";
                            tooltip-text: _("Add Account");

                            styles ["flat"]
                          }
                      }
                  }

                // Filled per account in accounts_dialog.py.
                Adw.PreferencesGroup bundles_group {
                    title: _("All Inboxes");
                    description: _("Accounts turned on here appear as one row in All Inboxes, like a category. The rest list each conversation on its own.");
                }
              };
          };
      };
  }
